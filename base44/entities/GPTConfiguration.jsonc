{
  "name": "GPTConfiguration",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nombre del modelo GPT personalizado"
    },
    "description": {
      "type": "string",
      "description": "Descripci\u00f3n del prop\u00f3sito del modelo"
    },
    "system_prompt": {
      "type": "string",
      "description": "System prompt personalizado para el modelo"
    },
    "output_type": {
      "type": "string",
      "enum": [
        "strategic_analysis",
        "copy_content",
        "custom"
      ],
      "description": "Tipo de salida que genera este modelo"
    },
    "model_name": {
      "type": "string",
      "default": "gpt-4-turbo",
      "description": "Nombre del modelo OpenAI a utilizar"
    },
    "temperature": {
      "type": "number",
      "default": 0.7,
      "description": "Temperatura para la generaci\u00f3n (0-1)"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Si este modelo est\u00e1 activo para ser utilizado"
    },
    "sort_order": {
      "type": "number",
      "default": 0,
      "description": "Orden de presentaci\u00f3n en la UI"
    }
  },
  "required": [
    "name",
    "description",
    "system_prompt",
    "output_type"
  ]
}