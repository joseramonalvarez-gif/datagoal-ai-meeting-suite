{
  "name": "Task",
  "type": "object",
  "properties": {
    "client_id": {
      "type": "string"
    },
    "project_id": {
      "type": "string"
    },
    "meeting_id": {
      "type": "string"
    },
    "transcript_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "backlog",
        "todo",
        "in_progress",
        "blocked",
        "in_review",
        "done"
      ],
      "default": "todo"
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "urgent"
      ],
      "default": "medium"
    },
    "assignees": {
      "type": "array",
      "description": "Multiple assignees",
      "items": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        }
      }
    },
    "assignee_email": {
      "type": "string",
      "description": "Deprecated: use assignees instead"
    },
    "assignee_name": {
      "type": "string",
      "description": "Deprecated: use assignees instead"
    },
    "watchers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "due_date": {
      "type": "string",
      "format": "date"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "checklist": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string"
          },
          "done": {
            "type": "boolean",
            "default": false
          }
        }
      }
    },
    "evidence_segments": {
      "type": "array",
      "description": "References to transcript segments",
      "items": {
        "type": "object",
        "properties": {
          "start_time": {
            "type": "string"
          },
          "end_time": {
            "type": "string"
          },
          "speaker_id": {
            "type": "string"
          },
          "speaker_label": {
            "type": "string"
          },
          "text_fragment": {
            "type": "string"
          },
          "user_email": {
            "type": "string"
          }
        }
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "attachments": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "linked_reports": {
      "type": "array",
      "description": "Report IDs bidirectionally linked to this task",
      "items": {
        "type": "string"
      }
    },
    "order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "client_id",
    "project_id",
    "title"
  ]
}