{
  "name": "Notification",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string"
    },
    "client_id": {
      "type": "string"
    },
    "project_id": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "task_assigned",
        "task_due_soon",
        "task_overdue",
        "mention",
        "approval_requested",
        "approval_decision",
        "milestone_completed",
        "report_generated",
        "meeting_scheduled"
      ]
    },
    "title": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "link": {
      "type": "string"
    },
    "is_read": {
      "type": "boolean",
      "default": false
    },
    "related_entity_type": {
      "type": "string"
    },
    "related_entity_id": {
      "type": "string"
    }
  },
  "required": [
    "user_email",
    "title"
  ]
}