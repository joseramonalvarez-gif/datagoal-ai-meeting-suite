{
  "name": "Post-Transcription Automation",
  "description": "Ejecuta reglas de workflow y crea follow-ups cuando una reuni\u00f3n es transcrita",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "Meeting"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "post_transcription_automation",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "postTranscriptionAutomation",
            "args": {
              "check_field": "status",
              "check_value": "transcribed"
            }
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "postTranscriptionAutomation"
  }
}